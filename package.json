{
  "name": "pi-ming-voice",
  "version": "0.1.1",
  "description": "Pi voice input using Ant Ling Ming-3.0-asr-tiny",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chasen-Liao/pi-ming-voice.git",
    "directory": "."
  },
  "homepage": "https://github.com/Chasen-Liao/pi-ming-voice#readme",
  "bugs": {
    "url": "https://github.com/Chasen-Liao/pi-ming-voice/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "voice",
    "ming",
    "ant-ling"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src/ming.ts",
    "bin",
    "docs/USAGE.md",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "ming-voice": "bin/ming-voice.mjs"
  },
  "pi": {
    "extensions": [
      "./src/ming.ts"
    ]
  },
  "scripts": {
    "key": "node ./bin/ming-voice.mjs key",
    "login": "node ./bin/ming-voice.mjs login",
    "test": "node --test \"test/*.test.mjs\"",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "pi-voice-stt": "0.8.0"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/darwin-arm64": "4.1.5",
    "@ffmpeg-installer/darwin-x64": "4.1.0",
    "@ffmpeg-installer/linux-arm64": "4.1.4",
    "@ffmpeg-installer/linux-x64": "4.1.0",
    "@ffmpeg-installer/win32-x64": "4.1.0"
  }
}
